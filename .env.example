# Copy to .env and replace every placeholder with local-only values.
# Never commit .env or use development values in production.
POSTGRES_DB=tripwarroom
DB_USERNAME=tripwarroom
DB_PASSWORD=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/tripwarroom

# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_RANDOM_32_BYTE_SECRET
